#!/bin/sh
set -e

# Resolve the real path of the install root (the parent directory of bin/)
# Follow a symlink (scripts/install.sh links this file into ~/.local/bin)
SELF="$(readlink -f -- "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd -P)"
INSTALL_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd -P)"

# Capture caller's original PYTHONPATH for vendor/executor child isolation (review-r3 Finding 1)
if [ -z "${_MESH_ORIG_PYTHONPATH+x}" ]; then
  export _MESH_ORIG_PYTHONPATH="${PYTHONPATH:-__UNSET__}"
fi

# Set PYTHONPATH to the install root ONLY for Mesh itself per plan L70 and §7.6 mitigation 8
export PYTHONPATH="$INSTALL_ROOT"

exec python3 -P -s -m mesh "$@"
