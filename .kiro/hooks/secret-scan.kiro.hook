{
  "enabled": true,
  "name": "Secret scan (staged changes)",
  "description": "Run before a commit: gitleaks (/tmp/gitleaks or PATH) with scripts/coord/gitleaks-baseline.json plus the coordinator pattern scan on the staged changes, and an absolute-home-path check for staged files under .kiro/. Exits nonzero on any finding or when gitleaks is missing. For the Kiro config tree run: bash .kiro/hooks/scripts/secret-scan.sh --dir .kiro",
  "version": "1",
  "when": {
    "type": "userTriggered",
    "patterns": [
      "**/*"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "bash .kiro/hooks/scripts/secret-scan.sh"
  }
}
